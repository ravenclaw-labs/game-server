##################################
# Nome do container
##################################
CONTAINER_NAME=scum-server

##################################
# Portas
##################################
PORT_GAME_UDP=7042
PORT_GAME_TCP=7042
PORT_QUERY_UDP=27015
PORT_RCON_TCP=27020

##################################
# Usuário / permissões
##################################
PUID=1000
PGID=1000

##################################
# Região / idioma
##################################
TZ=America/Sao_Paulo
TimeZone=America/Sao_Paulo
LANG=pt_BR.UTF-8

##################################
# LGSM / Servidor
##################################
START_MODE=1
START_VALIDATE=0
UPDATE_ON_START=1
VALIDATE_ON_START=0

##################################
# Rede / DNS
##################################
DNS_1=1.1.1.1
DNS_2=8.8.8.8

##################################
# Recursos
##################################
MAX_RAM_PERCENTAGE=75
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G
