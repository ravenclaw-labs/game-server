# Nome do container
CONTAINER_NAME=pz-server

# =====================
# PORTAS (Project Zomboid)
# =====================
# Porta principal (UDP)
PORT_UDP_MAIN=16261

# Portas adicionais por jogador (UDP)
PORT_UDP_1=16262
PORT_UDP_2=16263
PORT_UDP_3=16264
PORT_UDP_4=16265

# =====================
# LinuxGSM / Sistema
# =====================
PUID=1000
PGID=1000
TZ=America/Sao_Paulo
LANG=pt_BR.UTF-8

# Canal do servidor
VERSION=stable

# =====================
# Recursos
# =====================
MAX_RAM_PERCENTAGE=75

# DNS (opcional)
DNS_1=1.1.1.1
DNS_2=8.8.8.8

# =====================
# Limites Docker
# =====================
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G
