# Nome do container
CONTAINER_NAME=7dtd-server

# Configurações de porta
PORT_UDP_MAIN=26900
PORT_TCP_MAIN=26900
PORT_UDP_1=26901
PORT_UDP_2=26902

# Variáveis do servidor
START_MODE=1
START_VALIDATE=0
PUID=1000
PGID=1000
VERSION=stable
TimeZone=America/Sao_Paulo
LANG=pt_BR.UTF-8
TZ=America/Sao_Paulo
MAX_RAM_PERCENTAGE=75
DNS_1=1.1.1.1
DNS_2=8.8.8.8

# Limites de memória
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G
