# Nome do container
CONTAINER_NAME=aska-server

# Configurações de porta (mantendo padrão do teu .env)
PORT_UDP_MAIN=7777
PORT_QUERY=27015
PORT_RCON=27020

# Steam AppID do Dedicated Server
STEAM_APP_ID=3009480

# Variáveis do servidor
PUID=1000
PGID=1000
TimeZone=America/Sao_Paulo
LANG=pt_BR.UTF-8
TZ=America/Sao_Paulo
MAX_RAM_PERCENTAGE=75
DNS_1=1.1.1.1
DNS_2=8.8.8.8

# Limites de memória
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G
